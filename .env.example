# ==============================================================================
# AI Hallucination Hunter Configuration Environment Template
# Copy this file to '.env' and populate with your provider credentials.
# Do NOT commit real API secrets to source control.
# ==============================================================================

# LLM Provider Credentials
# Supports OpenAI or any OpenAI-compatible provider (Groq, Ollama, DeepSeek, Together, vLLM, etc.)
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.0

# Resource & DoS Protection Limits
MAX_CANDIDATE_ANSWER_CHARS=5000
MAX_EVIDENCE_ITEMS=20
MAX_EVIDENCE_TEXT_CHARS=10000
MAX_TOTAL_CHARS=50000
MAX_EXTRACTED_CLAIMS=30

# Application Environment
APP_NAME="AI Hallucination Hunter"
APP_VERSION=1.0.0
ENVIRONMENT=development
